# TradeScout AI configuration
# Copy this file to `.env` and adjust values as needed.
# All variables are prefixed with TRADESCOUT_.

TRADESCOUT_APP_NAME=TradeScout AI
TRADESCOUT_APP_VERSION=0.1.0

# SQLite database URL (relative paths resolve from the project root)
TRADESCOUT_DATABASE_URL=sqlite:///./tradescout.db

# Run with built-in mock data (no API keys required)
TRADESCOUT_MOCK_MODE=true

# Name used for the auto-generated demo campaign
TRADESCOUT_DEFAULT_CAMPAIGN_NAME=Demo Campaign

# --- LLM integration (leave blank to use offline heuristics) ---
TRADESCOUT_LLM_API_KEY=
TRADESCOUT_LLM_BASE_URL=https://api.openai.com/v1
TRADESCOUT_LLM_MODEL=gpt-4o-mini
